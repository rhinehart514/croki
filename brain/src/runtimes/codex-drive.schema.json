{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["tool", "final"] },
    "name": { "type": ["string", "null"] },
    "input": {
      "type": ["string", "null"],
      "description": "For a tool action, a JSON-encoded object containing that tool's arguments."
    },
    "summary": { "type": ["string", "null"] }
  },
  "required": ["type", "name", "input", "summary"],
  "additionalProperties": false
}
