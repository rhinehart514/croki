{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["electron/**/*.cjs"],
      "project": ["electron/**/*.{cjs,js,mjs}"]
    },
    "brain": {
      "entry": [
        "src/server.mjs",
        "src/mcp.mjs",
        "test/**/*.test.mjs"
      ],
      "project": ["src/**/*.mjs"]
    },
    "ui": {
      "entry": [
        "src/main.tsx",
        "**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "tailwindcss"
      ]
    }
  }
}
