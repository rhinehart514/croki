{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["electron/main.cjs", "electron/**/*.cjs"],
      "project": ["electron/**/*.{cjs,js,mjs}"]
    },
    "brain": {
      "entry": [
        "src/server.mjs",
        "src/mcp.mjs",
        "src/operator-mcp.mjs",
        "src/mirror.mjs",
        "src/terminal-server.mjs",
        "src/migrate-to-sqlite.mjs",
        "test/**/*.test.mjs"
      ],
      "project": ["src/**/*.mjs"]
    },
    "ui": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts",
        "vitest.config.ts",
        "src/test/setupTests.ts",
        "**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "tailwindcss",
        "tw-animate-css"
      ]
    }
  },
  "ignore": ["brain/src/demo/**"]
}
