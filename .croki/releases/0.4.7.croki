  "product": {
    "before": [
      "Agents reconstructed product intent from documents and conversation history.",
      "A checked interface disappeared after the active Preview moved on."
    ],
    "after": [
      "Opening a .croki object reveals its generated Application, Concept, Release, or Venture world.",
      "Every provider turn receives fresh, bounded application perception from validated project truth.",
      "Checked screens persist with their originating Thread and can be reopened later."
    ],
    "changes": [
      "The composer continuously shows application, release, and Concept scope.",
      "Developers can inspect visual .croki objects or open the exact structured source.",
      "Application, Concept, Release, and Venture scopes share one validated semantic model.",
      "Preview records successful UI checks as durable evidence without replacing the live page.",
      "Preview can discover components and develop provisional App, Component, and Idea options in the project’s real runtime."
    ],
    "removed": [
      "Manually synchronized concept indexes",
      "Prompts as stored application truth",
      "Canvas as durable maintained product memory"
    ]
  },
  "gtm": {
    "expression": [
      "Build many ideas independently without losing the coherence of the application they belong to.",
      "Your repository now knows what product it belongs to."
    ],
    "demoMoments": [
      "Open Croki’s application object and move visually from released reality into the 0.4.7 release story.",
      "Open a child Concept, inspect inherited truth, then return to its parent application.",
      "Reopen a checked screen from UI history in a later Thread turn.",
      "Launch the release-artifact studio and render the 0.4.7 product story in landscape or portrait."
    ]
  },
  "proof": [
    "All four .croki kinds pass shared validation and render without exposing raw source by default.",
    "Provider tests prove Release and Venture perception is bounded and fails open.",
    "UI-history tests prove checked screenshots remain tied to their source Thread."
  ],
  "successSignals": [
    "A new repository needs only an application object; normal coding remains available without one.",
    "A provider can explain its active application and release scope without the user pasting a brief.",
    "Invalid, unsupported, missing, or oversized scopes never block a native provider turn.",
    "The release view reads as an understandable before-and-after story rather than a dense data inspector."
  ],
  "learnings": [
    "A .croki file earns its boundary only when an agent can enter, inherit, work, and reconcile there.",
    "Product and GTM belong as lenses of the same scope rather than separate objects."
