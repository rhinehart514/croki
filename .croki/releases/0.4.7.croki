    "version": "0.4.5",
    "reality": "Croki kept native agent work inspectable through Threads, files, terminal, Preview, Git, checkpoints, Review, Senses, and child Threads."
  },
  "intent": "Make a normal repository aware of the product it belongs to, and let agents return to real interfaces they have checked.",
  "concepts": [
    "application-sense",
    "checked-screen-history",
    "preview-exploration",
    "release-artifacts"
