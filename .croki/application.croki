{
  "version": 1,
  "kind": "application",
  "application": {
    "id": "croki",
    "name": "Croki",
    "promise": "Build at agent speed without losing the coherence of the application.",
    "users": [
      "Founders building real software with coding agents"
    ]
  },
  "venture": ".croki/venture.croki",
  "activeRelease": ".croki/releases/0.4.7.croki",
  "released": {
    "version": "0.4.7",
    "summary": "Croki is an application-aware development environment where founders build through native coding-agent Threads, inspect real product behavior, explore ideas separately, and ship one coherent product.",
    "product": [
      "Configured Codex, Claude, Cursor, Grok, OpenCode, and OpenClaw providers retain their native behavior by default.",
      "Application, Concept, Release, and Venture .croki objects open as generated visual product worlds and supply bounded factual perception to agents.",
      "Separately explored Concepts inherit relevant parent reality while remaining isolated in native worktree Threads.",
      "Preview preserves checked-screen history and offers a default-off Beta for App, Component, and Idea exploration.",
      "Parallel workers persist as read-only child Threads beneath one canonical founder conversation."
    ],
    "gtm": [
      "Croki is for founders building real software with coding agents.",
      "The credible promise is building many ideas independently without losing the coherence of the application they belong to.",
      "Product and market claims must remain tied to observed behavior and source provenance."
    ],
    "learnings": [
      "A .croki object earns its boundary only when an agent can enter, inherit context, work independently, and reconcile it with a parent.",
      "Product and GTM are lenses of the same scope rather than separate object kinds.",
      "Perception must be derived on demand from native work instead of becoming a second workflow database."
    ],
    "sources": [
      {
        "kind": "git-tag",
        "ref": "v0.4.7"
      },
