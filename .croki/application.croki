{
  "version": 1,
  "kind": "application",
  "application": {
    "id": "croki",
    "name": "Croki",
    "promise": "Direct native coding agents through real software work without losing the state, evidence, or control needed to ship.",
    "users": [
      "Founders building real software with coding agents"
    ]
  },
  "released": {
    "version": "0.4.7",
    "summary": "Croki is an application-aware development environment where founders direct native coding-agent Threads and verify the resulting software through files, terminal, Preview, Review, Git, and durable checked screens.",
    "product": [
      "The selected coding provider remains the agent and retains its native reasoning, planning, delegation, memory, tools, and response behavior by default.",
      "Croki owns the durable environment around the provider: Threads, agents, repositories, worktrees, files, terminal, Preview, Review, Git, permissions, evidence, and recovery.",
      "Application context is bounded, source-backed, and only reaches a model when the founder explicitly adds its source to a message.",
      "Preview preserves checked-screen history as durable Thread evidence.",
      "Parallel workers persist as read-only child Threads beneath one canonical founder conversation."
    ],
    "gtm": [
      "Croki is for founders building real software with coding agents.",
      "The promise is agent-speed development without losing product coherence."
    ],
    "learnings": [
      "Croki should make native agent work easier to understand, resume, verify, and ship without becoming an implicit agent harness.",
      "Application direction should be easy for founders to apply without becoming hidden model behavior or a second workflow system.",
      "Observed evidence must remain distinct from founder-approved product direction and from a Croki-authored verdict."
    ],
    "sources": [
      {
        "kind": "git-tag",
        "ref": "v0.4.7"
      },
      {
        "kind": "file",
        "path": "docs/project/release-notes-0.4.7.md"
      }
    ]
  },
  "building": {
    "version": "0.4.8",
    "intent": "Integrate the current T3 Code substrate while making Croki an out-of-the-box host for native providers with no Croki-owned model harness or hidden context injection.",
    "product": [
      "Default turns send only the founder's visible message and attachments; Croki adds no persona, planning, delegation, application, progress, or sibling-work prompt.",
      ".croki/application.croki remains a visible repository brief with Add to message and Open actions; adding it creates a removable @file mention in the draft.",
      "Provider-native skills, files, models, modes, permissions, tools, and delegation stay available as explicit user choices.",
      "Threads, agents, files, terminal, Preview, Review, Git, usage, remote access, and mobile remain the environment around the provider.",
      "Historical Croki harness and Canvas receipts remain readable, while older clients attempting to send removed behavior fields receive a clear version-skew error."
    ],
    "gtm": [
      "Describe Croki as the ADE around native coding agents, not an agent runtime, orchestration system, or product-management system.",
      "Public platform and release claims must match enabled Croki-owned destinations."
    ],
    "successSignals": [
      "A default turn's provider input contains only the founder's visible message and attachments.",
      "The founder can add the application brief to a draft in one action and remove it before sending.",
      "No Product or Native behavior selector, automatic application context, or Croki parallel-work policy appears in active turn plumbing.",
      "Explicit provider-native skills, files, models, modes, permissions, and agent activity remain visible and usable.",
      "Croki overlay checks, typechecks, focused tests, and rendered interaction evidence pass against the integrated T3 base."
    ]
  }
}
