{
  "name": "@gtm-ide/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Drover's standalone token and component projection. The historical package name is retained for compatibility.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "npm run verify:tokens && tsup",
    "dev": "tsup --watch",
    "typecheck": "npm run verify:tokens && tsc --noEmit",
    "verify:tokens": "node ./scripts/verify-token-parity.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.3.5",
    "typescript": "~5.7.2"
  }
}
