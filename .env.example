# Optional: T3 Connect source builds
# `cp .env.example .env` enables T3 Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# CROKI_CLERK_PUBLISHABLE_KEY=pk_test_...
# CROKI_CLERK_JWT_TEMPLATE=t3-relay
# CROKI_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in CROKI_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# CROKI_APPLE_TEAM_ID=ABC1234567
# CROKI_MACOS_PROVISIONING_PROFILE=/absolute/path/to/croki.provisionprofile
# CROKI_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# CROKI_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Set this only when a Croki-owned hosted app deployment is available.
# CROKI_HOSTED_APP_URL=https://app.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# CROKI_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# CROKI_MOBILE_OTLP_TRACES_DATASET=croki-mobile-traces-dev
# CROKI_MOBILE_OTLP_TRACES_TOKEN=xaat-...
